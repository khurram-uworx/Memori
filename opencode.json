{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "microsoft-learn": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "code-memory": {
      "type": "local",
      "command": [
        "npx",
        "@uworx/code-memory"
      ]
    },
    "memori": {
      "type": "local",
      "command": [
        "dotnet",
        "run",
        "--project",
        ".\\src\\Memori.Mcp\\Memori.Mcp.csproj",
        "--long",
        "--vectors",
        "--verbose"
      ]
    }
  }
}
